[layer_names]

2d_physics/layer_1="PlayerCollider"
2d_physics/layer_2="PlayerHitbox"
2d_physics/layer_3="PlayerHurtbox"
2d_physics/layer_5="Terrain"
2d_physics/layer_9="EntityCollider"
2d_physics/layer_10="EntityHitbox"
2d_physics/layer_11="EntityHurtbox"
2d_physics/layer_14="Platform"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
